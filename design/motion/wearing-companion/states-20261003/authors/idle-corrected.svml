<?svml using="@hypit/markup@1"?>
<svml>
<import as="media" from="@hypit/media@1"/>
<import as="text" from="@hypit/text@1"/>
<import as="seedance" from="@hypit/seedance@1"/>
<import as="kit" source="@hypit/seedance-kits/broll"/>
<media:Image id="anchor" src="../anchor.png"/>
<text:Value id="direction">Use the supplied first and last frames as exact visual endpoints. One silent continuous fixed-camera shot, 720p square. Preserve this specific full-body soft fabric character: cream rounded rectangular head with ONLY TWO black vertical oval eyes and an otherwise completely blank face. No mouth, smile, nose, eyebrows, teeth, hair or extra facial marks at any time. Preserve cobalt blue textured cloth jacket, pale blue rolled cuffs, mitten hands with no fingers, pockets, buttons and proportions. Fixed lighting and uniform near-white background RGB 250 250 250, faint local contact shadow. Same full-body framing, scale and ground position. No zoom, camera movement, text, symbols, props, extra characters or audio. Movement is performed by the articulated body and cloth, never a whole-image wiggle. Start from the anchor, perform one action smoothly during the middle three seconds, settle back to the exact anchor and hold for the last half second. Animate ONLY the jacket fabric and mitten hands. The entire HEAD is a rigid static object: preserve all head pixels exactly throughout, including two black oval eyes and the uninterrupted BLANK cream area below. No face animation, no blinking, no breathing performance, no mouth opening, no third mark. The mitten resting on the opposite cuff relaxes a few millimeters and settles back. A small fold in the blue shoulder fabric softly relaxes. This is one tiny quiet cloth adjustment in a locked product photograph; all other objects remain motionless, including feet, head, torso location and camera. Finish at the exact same image. Priority: immutable two-eye mouthless character identity.</text:Value>
<text:Render id="prompt" template={kit.broll-v1}>
<text:Param name="material-mode" value="product-beauty"/>
<text:Param name="story-shape" value="single-moment"/>
<text:Param name="edit-language" value="continuous-shot"/>
<text:Param name="camera-language" value="reference-locked"/>
<text:Param name="motion-intensity" value="readable"/>
<text:Set name="story" text={direction}/>
</text:Render>
<seedance:FrameVideo id="idle" model="mini" prompt={prompt} duration="5" resolution="720p" aspect-ratio="1:1" generate-audio="false" first-frame={anchor} first-frame-person-reference="false" last-frame={anchor} last-frame-person-reference="false"/>
</svml>