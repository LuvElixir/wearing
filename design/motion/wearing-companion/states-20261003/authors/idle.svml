<?svml using="@hypit/markup@1"?>
<svml>
<import as="media" from="@hypit/media@1"/>
<import as="text" from="@hypit/text@1"/>
<import as="seedance" from="@hypit/seedance@1"/>
<import as="kit" source="@hypit/seedance-kits/broll"/>
<media:Image id="anchor" src="../anchor.png"/>
<text:Value id="direction">Use the supplied first and last frames as exact visual endpoints. One silent continuous fixed-camera shot, 720p square. Preserve this specific full-body soft fabric character: cream rounded rectangular head with ONLY TWO black vertical oval eyes and an otherwise completely blank face. No mouth, smile, nose, eyebrows, teeth, hair or extra facial marks at any time. Preserve cobalt blue textured cloth jacket, pale blue rolled cuffs, mitten hands with no fingers, pockets, buttons and proportions. Fixed lighting and uniform near-white background RGB 250 250 250, faint local contact shadow. Same full-body framing, scale and ground position. No zoom, camera movement, text, symbols, props, extra characters or audio. Movement is performed by the articulated body and cloth, never a whole-image wiggle. Start from the anchor, perform one action smoothly during the middle three seconds, settle back to the exact anchor and hold for the last half second. The character rests comfortably: one soft breath subtly lifts the shoulders and blue fabric, a tiny weight settle through the knees, then a relaxed return to the exact starting cuff-holding stance. Head remains essentially still and eyes unchanged. A quiet grounded presence. No foot lifting or rocking back and forth.</text:Value>
<text:Render id="prompt" template={kit.broll-v1}>
<text:Param name="material-mode" value="product-beauty"/>
<text:Param name="story-shape" value="single-moment"/>
<text:Param name="edit-language" value="continuous-shot"/>
<text:Param name="camera-language" value="reference-locked"/>
<text:Param name="motion-intensity" value="readable"/>
<text:Set name="story" text={direction}/>
</text:Render>
<seedance:FrameVideo id="idle" model="mini" prompt={prompt} duration="5" resolution="720p" aspect-ratio="1:1" generate-audio="false" first-frame={anchor} first-frame-person-reference="false" last-frame={anchor} last-frame-person-reference="false"/>
</svml>