<?svml using="@hypit/markup@1"?>
<svml>
<import as="media" from="@hypit/media@1"/><import as="text" from="@hypit/text@1"/><import as="seedance" from="@hypit/seedance@1"/><import as="kit" source="@hypit/seedance-kits/broll"/>
<media:Image id="anchor" src="../assets/blue-anchor.png"/>
<text:Value id="direction">A quiet attentive plush companion notices its person. Preserve this exact warm beige teddy, round head and short rounded limbs, shiny brown eyes, small cocoa nose, closed sewn mouth, blue striped pajamas with ivory piping and three buttons. Fixed square camera, full body always visible, feet planted at exactly the same baseline, consistent scale. White seamless studio background remains uniform white. Start in the supplied pose. It briefly tilts its head toward the viewer, blinks once naturally, gives one gentle small paw greeting using its wrist and elbow, then its shoulder relaxes and it returns exactly to the supplied pose. Body parts articulate naturally; no moving a flat photograph, no bouncing the entire character, no scaling or sliding. The friendly attention comes from the glance and small gesture, not a grin. Mouth stays closed. Keep tactile fur, fabric folds and continuous stable identity. First and final half seconds settle in exactly the anchor pose for a seamless loop. No camera motion, cuts, props, letters, music or speech.</text:Value>
<text:Render id="prompt" template={kit.broll-v1}><text:Param name="material-mode" value="product-beauty"/><text:Param name="story-shape" value="single-moment"/><text:Param name="edit-language" value="continuous-shot"/><text:Param name="camera-language" value="reference-locked"/><text:Param name="motion-intensity" value="readable"/><text:Set name="story" text={direction}/></text:Render>
<seedance:FrameVideo id="idle" model="mini" prompt={prompt} duration="5" resolution="720p" aspect-ratio="1:1" generate-audio="false" first-frame={anchor} first-frame-person-reference="false" last-frame={anchor} last-frame-person-reference="false"/>
</svml>