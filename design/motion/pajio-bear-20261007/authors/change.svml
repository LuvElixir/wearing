<?svml using="@hypit/markup@1"?>
<svml>
<import as="media" from="@hypit/media@1"/><import as="text" from="@hypit/text@1"/><import as="seedance" from="@hypit/seedance@1"/><import as="kit" source="@hypit/seedance-kits/broll"/>
<media:Image id="anchor" src="../assets/blue-anchor.png"/><media:Image id="cream" src="../assets/cream-anchor.png"/>
<text:Value id="direction">A cute tactile plush teddy trying on a new pair of pajamas. First frame is the precise blue striped outfit; last frame is the same teddy in cream cotton pajamas with golden piping and crescent pocket. One continuous locked full-body square studio shot on white. All head and face features, warm beige fur, body dimensions and foot baseline stay consistent. The teddy looks down affectionately at its sleeve, lowers its raised paw to smooth its blue lapel, then performs one quick natural full-body turn on its feet. During the hidden back-facing part of the turn the pajamas change from blue stripes to cream cotton. It returns to face us in the new cream outfit, glances at its sleeve and lifts its paw into the exact final pose. Cloth follows the articulated movement, with a soft realistic swish. Preserve the tiny stitched closed mouth; no talking, broad grin, stretch, rubbery morph or face changing. The garment changes during the turn, with no naked stage. No cuts, camera move, jump in size, confetti, sparkles, new props, captions or sound. Land precisely at the last-frame pose and hold still for the final half-second.</text:Value>
<text:Render id="prompt" template={kit.broll-v1}><text:Param name="material-mode" value="product-beauty"/><text:Param name="story-shape" value="single-moment"/><text:Param name="edit-language" value="continuous-shot"/><text:Param name="camera-language" value="reference-locked"/><text:Param name="motion-intensity" value="readable"/><text:Set name="story" text={direction}/></text:Render>
<seedance:FrameVideo id="change" model="mini" prompt={prompt} duration="5" resolution="720p" aspect-ratio="1:1" generate-audio="false" first-frame={anchor} first-frame-person-reference="false" last-frame={cream} last-frame-person-reference="false"/>
</svml>