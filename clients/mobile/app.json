{
  "expo": {
    "name": "Wearing",
    "slug": "wearing-mobile",
    "version": "0.2.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "wearing",
    "ios": {
      "bundleIdentifier": "io.luckyloading.wearing.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "io.luckyloading.wearing.mobile",
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "选择一张图片，交给 Wearing 一起记着。",
          "cameraPermission": "拍一张照片，交给 Wearing 一起记着。"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "说一句，Wearing 会先把录音保存在本机。",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "./plugins/local-preview.cjs",
      "expo-router",
      "expo-video",
      [
        "expo-calendar",
        {
          "calendarPermission": "允许 Wearing 读取你选择的日历，整理日程；仅在你确认后带入对话。",
          "remindersPermission": "允许 Wearing 读取提醒事项。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "需要附近的信息时，允许 Wearing 获取一次当前位置。"
        }
      ]
    ]
  }
}
