{
  "expo": {
    "name": "Pajio",
    "slug": "wearing-mobile",
    "version": "0.2.0",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": [
      "pajio",
      "wearing"
    ],
    "ios": {
      "bundleIdentifier": "io.luckyloading.wearing.mobile",
      "buildNumber": "2",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": false,
          "NSExceptionDomains": {}
        }
      }
    },
    "android": {
      "package": "io.luckyloading.wearing.mobile",
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FBF7E9"
      },
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "选择一张图片，交给 Pajio 一起记着。",
          "cameraPermission": "拍一张照片，交给 Pajio 一起记着。"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "说一句，Pajio 会先把录音保存在本机。",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "./plugins/local-preview.cjs",
      "expo-router",
      "expo-video",
      [
        "expo-calendar",
        {
          "calendarPermission": "允许 Pajio 查看系统日历，并在你操作时添加、修改或删除日程。",
          "remindersPermission": "允许 Pajio 查看提醒事项，并在你操作时添加、修改、完成或删除提醒。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "需要附近的信息时，允许 Pajio 获取一次当前位置。"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7F9",
          "image": "./assets/splash-icon.png",
          "imageWidth": 72,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#14161A"
          }
        }
      ],
      "expo-system-ui",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "./plugins/share-intake.cjs",
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications"
    ]
  }
}
