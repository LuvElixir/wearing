# Internal acceptance environment: one VM per bridge, no office-LAN bridging.
# Only this file's named tables are managed by apply-lab-network.sh.
table inet pajio_lab_guard {
    set guests {
        type ifname
        elements = { "pj100", "pj101", "pj102" }
    }
    set nonpublic {
        type ipv4_addr
        flags interval
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10,
            127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12,
            192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16,
            198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24,
            224.0.0.0/4, 240.0.0.0/4 }
    }
    chain host_input {
        type filter hook input priority -10; policy accept;
        iifname @guests meta nfproto ipv6 counter drop
        iifname "pj100" ip saddr != 10.77.100.2 counter drop
        iifname "pj101" ip saddr != 10.77.101.2 counter drop
        iifname "pj102" ip saddr != 10.77.102.2 counter drop
        # Replies to host-initiated administration are allowed; guests cannot
        # initiate connections to ANY address belonging to the hypervisor.
        iifname @guests ct state established,related counter accept
        iifname @guests counter drop
    }
    chain guest_forward {
        type filter hook forward priority -10; policy accept;
        iifname @guests meta nfproto ipv6 counter drop
        oifname @guests meta nfproto ipv6 counter drop
        iifname "pj100" ip saddr != 10.77.100.2 counter drop
        iifname "pj101" ip saddr != 10.77.101.2 counter drop
        iifname "pj102" ip saddr != 10.77.102.2 counter drop
        # Authenticated application control path only; no guest management access.
        iifname "pj100" ip saddr 10.77.100.2 ip daddr 134.175.112.118 udp dport 51820 counter accept
        iifname "pj100" ip saddr 10.77.100.2 ip daddr { 10.77.101.2, 10.77.102.2 } tcp dport 8443 counter accept
        iifname { "pj101", "pj102" } oifname "pj100" ip daddr 10.77.100.2 ct state established,related counter accept
        iifname @guests ip daddr @nonpublic counter drop
        iifname @guests oifname "vmbr0" tcp dport { 80, 443 } counter accept
        iifname @guests oifname "vmbr0" ip daddr { 223.5.5.5, 1.1.1.1 } udp dport 53 counter accept
        iifname @guests oifname "vmbr0" ip daddr { 223.5.5.5, 1.1.1.1 } tcp dport 53 counter accept
        iifname @guests oifname "vmbr0" udp dport 123 counter accept
        iifname @guests counter drop
        oifname @guests ct state established,related counter accept
        oifname @guests counter drop
    }
}
table ip pajio_lab_nat {
    chain guest_nat {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "vmbr0" ip saddr { 10.77.100.2, 10.77.101.2, 10.77.102.2 } masquerade
    }
}
